# ══════════════════════════════════════════════════════════
# 配置模板 —— 复制本文件为 config/.env 后填入真实值
#   （config/.env 已被 .gitignore 排除，不会被提交到 GitHub）
# ══════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────
# 大模型：智谱 GLM（推荐，Flash 系列免费）
#   注册地址：https://open.bigmodel.cn → 右上角「API密钥」
# ──────────────────────────────────────────────────────────
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=sk-在这里粘贴你的Key
LLM_MODEL_MAIN=glm-5.3-flashx
LLM_MODEL_LIGHT=glm-5.3-flashx
LLM_TIMEOUT=300
# 必须显式限制输出长度，否则模型可能生成到平台上限，单次调用拖十几分钟
LLM_MAX_TOKENS=16384
# 设为 1 打印每次调用的耗时（调试用），0 关闭
LLM_VERBOSE=0

# 不知道模型名填哪个？双击 1_自检模型.bat，
# 它会列出你账号下真实可用的模型名，直接复制过来。

# ──────────────────────────────────────────────────────────
# 备选：DeepSeek / 硅基流动（OpenAI 兼容接口均可）
#   把上面四项 LLM_* 换成对应平台的地址、Key、模型名即可
# ──────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────
# 腾讯地图（作战环境地图底图，可选）
#   申请地址：https://lbs.qq.com → 控制台 → 创建应用 → 添加 Key
#   注意：Key 要在腾讯位置服务后台配置「授权域名/白名单」
#   不配置也能用：地图显示「体验额度」版（功能正常，仅底图有水印）
# ──────────────────────────────────────────────────────────
TENCENT_MAP_KEY=
